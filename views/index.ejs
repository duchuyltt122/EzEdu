<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <!-- Header -->
        <header class="header">
            <div class="mascot-container">
                <div class="mascot main-mascot">
                    <div class="mascot-face">😊</div>
                    <div class="mascot-antenna"></div>
                </div>
                <div class="mascot small-mascot">
                    <div class="mascot-face">😊</div>
                    <div class="mascot-antenna"></div>
                </div>
            </div>
            <h1 class="app-title">Edu</h1>
        </header>

        <!-- Main Content -->
        <main class="main-content">
            <div class="game-section">
                <h2 class="section-title">Trò chơi<br>tương tác</h2>
                
                <div class="games-grid">
                    <% games.forEach(function(game) { %>
                        <div class="game-card <%= game.color %>" onclick="playGame('<%= game.id %>')">
                            <div class="game-icon">
                                <% if (game.id === 'ghep-chu') { %>
                                    <div class="house-icon">
                                        <div class="house-roof"></div>
                                        <div class="house-body">
                                            <div class="house-door"></div>
                                        </div>
                                    </div>
                                    <div class="letter-blocks">
                                        <span class="letter-block">M</span>
                                        <span class="letter-block">E</span>
                                    </div>
                                <% } else if (game.id === 'xep-gach') { %>
                                    <div class="brick-stack">
                                        <div class="brick">T</div>
                                        <div class="brick">U</div>
                                        <div class="brick">D</div>
                                    </div>
                                <% } else if (game.id === 'cau-do') { %>
                                    <div class="quiz-icon">
                                        <div class="question-mark">?</div>
                                        <div class="quiz-button">Câu đố</div>
                                    </div>
                                <% } %>
                            </div>
                            <h3 class="game-title"><%= game.name %></h3>
                        </div>
                    <% }); %>
                </div>
            </div>
        </main>
    </div>

    <script src="/js/main.js"></script>
</body>
</html>
